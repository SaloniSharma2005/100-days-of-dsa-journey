class Solution {
    public ListNode mergeInBetween(ListNode list1, int a, int b, ListNode list2) {

        ListNode beforeA = list1;

        for (int i = 0; i < a - 1; i++) {
            beforeA = beforeA.next;
        }

        ListNode afterB = beforeA;

        for (int i = 0; i < b - a + 2; i++) {
            afterB = afterB.next;
        }

        beforeA.next = list2;

        while (list2.next != null) {
            list2 = list2.next;
        }

        list2.next = afterB;

        return list1;
    }
}
